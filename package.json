{
  "name": "image-gen-mcp",
  "version": "1.0.0",
  "description": "Stdio MCP server that generates and edits images with Gemini and OpenAI using your own API keys",
  "mcpName": "com.nuverlabs/image-gen",
  "type": "module",
  "license": "MIT",
  "author": "Nuver Labs (https://nuverlabs.com)",
  "homepage": "https://github.com/nuver-labs/image-gen-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuver-labs/image-gen-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nuver-labs/image-gen-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "claude-code",
    "ai-agent",
    "llm",
    "image-generation",
    "image-editing",
    "gemini",
    "nano-banana",
    "openai",
    "gpt-image"
  ],
  "bin": { "image-gen-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "start": "node dist/index.js",
    "smoke": "pnpm build && node dist/smoke.js",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector@0.22.0 --cli node dist/index.js --method tools/list",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.46.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
